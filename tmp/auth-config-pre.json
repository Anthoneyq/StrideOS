  "mailer_subjects_confirmation": "Confirm your STRIDE OS account",
  "mailer_templates_confirmation_content": "<!DOCTYPE html>\n<html lang=\"en\">\n  <body style=\"margin:0;padding:0;background:#0e0f12;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#f3f4f6;\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#0e0f12;padding:40px 0;\">\n      <tr>\n        <td align=\"center\">\n          <table role=\"presentation\" width=\"540\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#16181d;border:1px solid #23262d;border-radius:12px;padding:40px;\">\n            <tr>\n              <td style=\"text-align:left;\">\n                <div style=\"font-size:13px;font-weight:600;letter-spacing:2px;color:#ff4500;text-transform:uppercase;\">STRIDE OS</div>\n                <h1 style=\"margin:24px 0 16px 0;font-size:24px;font-weight:600;color:#f3f4f6;\">Confirm your email</h1>\n                <p style=\"margin:0 0 16px 0;line-height:1.55;color:#c9cdd4;\">\n                  Welcome to STRIDE OS. Click the button below to confirm your email and finish setting up your coach account.\n                </p>\n                <p style=\"margin:32px 0;\">\n                  <a href=\"{{ .ConfirmationURL }}\"\n                     style=\"background:#ff4500;color:#ffffff;text-decoration:none;padding:14px 28px;border-radius:8px;font-weight:600;display:inline-block;\">\n                    Confirm email\n                  </a>\n                </p>\n                <p style=\"margin:0 0 8px 0;line-height:1.55;color:#7a7f88;font-size:13px;\">\n                  If the button doesn't work, copy and paste this URL into your browser:\n                </p>\n                <p style=\"margin:0 0 24px 0;line-height:1.55;color:#9ca3af;font-size:13px;word-break:break-all;\">\n                  {{ .ConfirmationURL }}\n                </p>\n                <hr style=\"border:none;border-top:1px solid #23262d;margin:24px 0;\">\n                <p style=\"margin:0;line-height:1.55;color:#7a7f88;font-size:12px;\">\n                  You're receiving this because someone signed up at STRIDE OS using this email address. If that wasn't you, ignore this message.\n                </p>\n              </td>\n            </tr>\n          </table>\n          <p style=\"margin:24px 0 0 0;color:#5b6068;font-size:12px;\">\n            STRIDE OS &middot; CoachLab &middot; admin@thecoachlab.app\n          </p>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>\n",
  "mailer_subjects_email_change": "Confirm your new STRIDE OS email",
  "mailer_templates_email_change_content": "<!DOCTYPE html>\n<html lang=\"en\">\n  <body style=\"margin:0;padding:0;background:#0e0f12;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#f3f4f6;\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#0e0f12;padding:40px 0;\">\n      <tr>\n        <td align=\"center\">\n          <table role=\"presentation\" width=\"540\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#16181d;border:1px solid #23262d;border-radius:12px;padding:40px;\">\n            <tr>\n              <td style=\"text-align:left;\">\n                <div style=\"font-size:13px;font-weight:600;letter-spacing:2px;color:#ff4500;text-transform:uppercase;\">STRIDE OS</div>\n                <h1 style=\"margin:24px 0 16px 0;font-size:24px;font-weight:600;color:#f3f4f6;\">Confirm your new email</h1>\n                <p style=\"margin:0 0 16px 0;line-height:1.55;color:#c9cdd4;\">\n                  You asked to change the email on your STRIDE OS coach account. Click below to confirm the new address.\n                </p>\n                <p style=\"margin:32px 0;\">\n                  <a href=\"{{ .ConfirmationURL }}\"\n                     style=\"background:#ff4500;color:#ffffff;text-decoration:none;padding:14px 28px;border-radius:8px;font-weight:600;display:inline-block;\">\n                    Confirm new email\n                  </a>\n                </p>\n                <p style=\"margin:0 0 8px 0;line-height:1.55;color:#7a7f88;font-size:13px;\">\n                  If the button doesn't work, copy and paste this URL into your browser:\n                </p>\n                <p style=\"margin:0 0 24px 0;line-height:1.55;color:#9ca3af;font-size:13px;word-break:break-all;\">\n                  {{ .ConfirmationURL }}\n                </p>\n                <hr style=\"border:none;border-top:1px solid #23262d;margin:24px 0;\">\n                <p style=\"margin:0;line-height:1.55;color:#7a7f88;font-size:12px;\">\n                  Didn't request this change? Contact us at admin@thecoachlab.app immediately.\n                </p>\n              </td>\n            </tr>\n          </table>\n          <p style=\"margin:24px 0 0 0;color:#5b6068;font-size:12px;\">\n            STRIDE OS &middot; CoachLab &middot; admin@thecoachlab.app\n          </p>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>\n",
  "mailer_subjects_invite": "You've been invited to STRIDE OS",
  "mailer_templates_invite_content": "<!DOCTYPE html>\n<html lang=\"en\">\n  <body style=\"margin:0;padding:0;background:#0e0f12;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#f3f4f6;\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#0e0f12;padding:40px 0;\">\n      <tr>\n        <td align=\"center\">\n          <table role=\"presentation\" width=\"540\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#16181d;border:1px solid #23262d;border-radius:12px;padding:40px;\">\n            <tr>\n              <td style=\"text-align:left;\">\n                <div style=\"font-size:13px;font-weight:600;letter-spacing:2px;color:#ff4500;text-transform:uppercase;\">STRIDE OS</div>\n                <h1 style=\"margin:24px 0 16px 0;font-size:24px;font-weight:600;color:#f3f4f6;\">You're invited to STRIDE OS</h1>\n                <p style=\"margin:0 0 16px 0;line-height:1.55;color:#c9cdd4;\">\n                  You've been invited to join STRIDE OS \u2014 a pacing, prediction, and athlete development tool built for coaches. Accept the invitation to set up your coach account.\n                </p>\n                <p style=\"margin:32px 0;\">\n                  <a href=\"{{ .ConfirmationURL }}\"\n                     style=\"background:#ff4500;color:#ffffff;text-decoration:none;padding:14px 28px;border-radius:8px;font-weight:600;display:inline-block;\">\n                    Accept invitation\n                  </a>\n                </p>\n                <p style=\"margin:0 0 8px 0;line-height:1.55;color:#7a7f88;font-size:13px;\">\n                  If the button doesn't work, copy and paste this URL into your browser:\n                </p>\n                <p style=\"margin:0 0 24px 0;line-height:1.55;color:#9ca3af;font-size:13px;word-break:break-all;\">\n                  {{ .ConfirmationURL }}\n                </p>\n                <hr style=\"border:none;border-top:1px solid #23262d;margin:24px 0;\">\n                <p style=\"margin:0;line-height:1.55;color:#7a7f88;font-size:12px;\">\n                  Wasn't expecting this invite? You can safely ignore the email.\n                </p>\n              </td>\n            </tr>\n          </table>\n          <p style=\"margin:24px 0 0 0;color:#5b6068;font-size:12px;\">\n            STRIDE OS &middot; CoachLab &middot; admin@thecoachlab.app\n          </p>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>\n",
  "mailer_subjects_magic_link": "Your STRIDE OS sign-in link",
  "mailer_templates_magic_link_content": "<!DOCTYPE html>\n<html lang=\"en\">\n  <body style=\"margin:0;padding:0;background:#0e0f12;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#f3f4f6;\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#0e0f12;padding:40px 0;\">\n      <tr>\n        <td align=\"center\">\n          <table role=\"presentation\" width=\"540\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#16181d;border:1px solid #23262d;border-radius:12px;padding:40px;\">\n            <tr>\n              <td style=\"text-align:left;\">\n                <div style=\"font-size:13px;font-weight:600;letter-spacing:2px;color:#ff4500;text-transform:uppercase;\">STRIDE OS</div>\n                <h1 style=\"margin:24px 0 16px 0;font-size:24px;font-weight:600;color:#f3f4f6;\">Your sign-in link</h1>\n                <p style=\"margin:0 0 16px 0;line-height:1.55;color:#c9cdd4;\">\n                  Click the button below to sign in to your STRIDE OS coach account. The link expires in one hour and can only be used once.\n                </p>\n                <p style=\"margin:32px 0;\">\n                  <a href=\"{{ .ConfirmationURL }}\"\n                     style=\"background:#ff4500;color:#ffffff;text-decoration:none;padding:14px 28px;border-radius:8px;font-weight:600;display:inline-block;\">\n                    Sign in to STRIDE OS\n                  </a>\n                </p>\n                <p style=\"margin:0 0 8px 0;line-height:1.55;color:#7a7f88;font-size:13px;\">\n                  If the button doesn't work, copy and paste this URL into your browser:\n                </p>\n                <p style=\"margin:0 0 24px 0;line-height:1.55;color:#9ca3af;font-size:13px;word-break:break-all;\">\n                  {{ .ConfirmationURL }}\n                </p>\n                <hr style=\"border:none;border-top:1px solid #23262d;margin:24px 0;\">\n                <p style=\"margin:0;line-height:1.55;color:#7a7f88;font-size:12px;\">\n                  Didn't request this? You can safely ignore the email \u2014 no one can sign in without the link.\n                </p>\n              </td>\n            </tr>\n          </table>\n          <p style=\"margin:24px 0 0 0;color:#5b6068;font-size:12px;\">\n            STRIDE OS &middot; CoachLab &middot; admin@thecoachlab.app\n          </p>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>\n",
  "mailer_subjects_recovery": "Reset your STRIDE OS password",
  "mailer_templates_recovery_content": "<!DOCTYPE html>\n<html lang=\"en\">\n  <body style=\"margin:0;padding:0;background:#0e0f12;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#f3f4f6;\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#0e0f12;padding:40px 0;\">\n      <tr>\n        <td align=\"center\">\n          <table role=\"presentation\" width=\"540\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#16181d;border:1px solid #23262d;border-radius:12px;padding:40px;\">\n            <tr>\n              <td style=\"text-align:left;\">\n                <div style=\"font-size:13px;font-weight:600;letter-spacing:2px;color:#ff4500;text-transform:uppercase;\">STRIDE OS</div>\n                <h1 style=\"margin:24px 0 16px 0;font-size:24px;font-weight:600;color:#f3f4f6;\">Reset your password</h1>\n                <p style=\"margin:0 0 16px 0;line-height:1.55;color:#c9cdd4;\">\n                  We received a request to reset the password on your STRIDE OS account. Click the button below to set a new one.\n                </p>\n                <p style=\"margin:32px 0;\">\n                  <a href=\"{{ .ConfirmationURL }}\"\n                     style=\"background:#ff4500;color:#ffffff;text-decoration:none;padding:14px 28px;border-radius:8px;font-weight:600;display:inline-block;\">\n                    Reset password\n                  </a>\n                </p>\n                <p style=\"margin:0 0 8px 0;line-height:1.55;color:#7a7f88;font-size:13px;\">\n                  If the button doesn't work, copy and paste this URL into your browser:\n                </p>\n                <p style=\"margin:0 0 24px 0;line-height:1.55;color:#9ca3af;font-size:13px;word-break:break-all;\">\n                  {{ .ConfirmationURL }}\n                </p>\n                <hr style=\"border:none;border-top:1px solid #23262d;margin:24px 0;\">\n                <p style=\"margin:0;line-height:1.55;color:#7a7f88;font-size:12px;\">\n                  Didn't request a password reset? You can safely ignore this email \u2014 your current password will stay active.\n                </p>\n              </td>\n            </tr>\n          </table>\n          <p style=\"margin:24px 0 0 0;color:#5b6068;font-size:12px;\">\n            STRIDE OS &middot; CoachLab &middot; admin@thecoachlab.app\n          </p>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>\n"
}